// ER-диаграмма HotelBooking в нотации Crow's Foot.
// PNG и SVG: dot -Tpng -Gdpi=150 er-diagram.dot -o er-diagram.png && dot -Tsvg er-diagram.dot -o er-diagram.svg

digraph hotel_booking {
  graph [rankdir=LR, splines=spline, nodesep=0.6, ranksep=1.3, pad=0.4, bgcolor="white", fontname="Helvetica"];
  node  [shape=plain, fontname="Helvetica", fontsize=12];
  edge  [dir=both, color="#334155", penwidth=1.4, arrowsize=1.1, fontname="Helvetica", fontsize=10, fontcolor="#475569"];

  users [label=<
    <table border="1" cellborder="0" cellspacing="0" cellpadding="5" color="#334155">
      <tr><td colspan="3" bgcolor="#1e3a5f"><font color="white"><b>users</b></font></td></tr>
      <tr><td align="left"><b>PK</b></td><td align="left"><b>id</b></td><td port="id" align="left">int</td></tr>
      <tr><td align="left">UK</td><td align="left">email</td><td align="left">varchar(100)</td></tr>
      <tr><td></td><td align="left">password_hash</td><td align="left">varchar(255)</td></tr>
      <tr><td></td><td align="left">full_name</td><td align="left">varchar(100)</td></tr>
      <tr><td></td><td align="left">phone</td><td align="left">varchar(20), null</td></tr>
      <tr><td></td><td align="left">role</td><td align="left">enum: guest, admin, manager</td></tr>
      <tr><td></td><td align="left">created_at</td><td align="left">timestamptz</td></tr>
    </table>>];

  room_types [label=<
    <table border="1" cellborder="0" cellspacing="0" cellpadding="5" color="#334155">
      <tr><td colspan="3" bgcolor="#1e3a5f"><font color="white"><b>room_types</b></font></td></tr>
      <tr><td align="left"><b>PK</b></td><td align="left"><b>id</b></td><td port="id" align="left">int</td></tr>
      <tr><td align="left">UK</td><td align="left">name</td><td align="left">varchar(50)</td></tr>
      <tr><td></td><td align="left">capacity</td><td align="left">int</td></tr>
      <tr><td></td><td align="left">price_per_night</td><td align="left">numeric(10,2)</td></tr>
      <tr><td></td><td align="left">description</td><td align="left">text, null</td></tr>
    </table>>];

  rooms [label=<
    <table border="1" cellborder="0" cellspacing="0" cellpadding="5" color="#334155">
      <tr><td colspan="3" bgcolor="#1e3a5f"><font color="white"><b>rooms</b></font></td></tr>
      <tr><td align="left"><b>PK</b></td><td align="left"><b>id</b></td><td port="id" align="left">int</td></tr>
      <tr><td align="left">UK</td><td align="left">number</td><td align="left">varchar(10)</td></tr>
      <tr><td></td><td align="left">floor</td><td align="left">int</td></tr>
      <tr><td port="room_type_id" align="left">FK</td><td align="left">room_type_id</td><td align="left">int</td></tr>
      <tr><td></td><td align="left">status</td><td align="left">enum: available, maintenance</td></tr>
    </table>>];

  bookings [label=<
    <table border="1" cellborder="0" cellspacing="0" cellpadding="5" color="#334155">
      <tr><td colspan="3" bgcolor="#1e3a5f"><font color="white"><b>bookings</b></font></td></tr>
      <tr><td align="left"><b>PK</b></td><td align="left"><b>id</b></td><td port="id" align="left">int</td></tr>
      <tr><td port="guest_id" align="left">FK</td><td align="left">guest_id</td><td align="left">int</td></tr>
      <tr><td></td><td align="left">check_in</td><td align="left">date</td></tr>
      <tr><td></td><td align="left">check_out</td><td align="left">date</td></tr>
      <tr><td></td><td align="left">status</td><td align="left">enum: pending, confirmed,<br align="left"/>checked_in, checked_out, cancelled<br align="left"/></td></tr>
      <tr><td></td><td align="left">total_price</td><td align="left">numeric(10,2)</td></tr>
      <tr><td></td><td align="left">created_at</td><td align="left">timestamptz</td></tr>
    </table>>];

  booking_rooms [label=<
    <table border="1" cellborder="0" cellspacing="0" cellpadding="5" color="#334155">
      <tr><td colspan="3" bgcolor="#1e3a5f"><font color="white"><b>booking_rooms</b></font></td></tr>
      <tr><td align="left"><b>PK</b></td><td align="left"><b>id</b></td><td align="left">int</td></tr>
      <tr><td port="booking_id" align="left">FK</td><td align="left">booking_id</td><td align="left">int</td></tr>
      <tr><td port="room_id" align="left">FK</td><td align="left">room_id</td><td align="left">int</td></tr>
      <tr><td></td><td align="left">price_per_night</td><td align="left">numeric(10,2)</td></tr>
      <tr><td></td><td align="left">check_in</td><td align="left">date</td></tr>
      <tr><td></td><td align="left">check_out</td><td align="left">date</td></tr>
      <tr><td></td><td align="left">is_active</td><td align="left">boolean</td></tr>
    </table>>];

  payments [label=<
    <table border="1" cellborder="0" cellspacing="0" cellpadding="5" color="#334155">
      <tr><td colspan="3" bgcolor="#1e3a5f"><font color="white"><b>payments</b></font></td></tr>
      <tr><td align="left"><b>PK</b></td><td align="left"><b>id</b></td><td align="left">int</td></tr>
      <tr><td port="booking_id" align="left">FK</td><td align="left">booking_id</td><td align="left">int</td></tr>
      <tr><td></td><td align="left">amount</td><td align="left">numeric(10,2)</td></tr>
      <tr><td></td><td align="left">paid_at</td><td align="left">timestamptz</td></tr>
      <tr><td></td><td align="left">method</td><td align="left">enum: cash, card, transfer</td></tr>
    </table>>];

  // Хвост ребра на стороне «один», голова на стороне «многие».
  users:id:e      -> bookings:guest_id:w          [arrowtail=teetee, arrowhead=crowodot];
  room_types:id:e -> rooms:room_type_id:w         [arrowtail=teetee, arrowhead=crowodot];
  bookings:id:e   -> booking_rooms:booking_id:w   [arrowtail=teetee, arrowhead=crowtee];
  rooms:id:e      -> booking_rooms:room_id:w      [arrowtail=teetee, arrowhead=crowodot];
  bookings:id:e   -> payments:booking_id:w        [arrowtail=teetee, arrowhead=crowodot];

  { rank=same; users; room_types; }
  { rank=same; bookings; rooms; }
  { rank=same; booking_rooms; payments; }
}
