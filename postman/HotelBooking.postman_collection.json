{
  "info": {
    "name": "HotelBooking API",
    "description": "CRUD API HotelBooking: категории номеров, номера, пользователи. Пагинация page/per_page с метаданными, сортировка sort_by/sort_order, фильтры и поиск, статистика и отчёт, единый формат ошибок с error_code.\n\nПеред запуском: сервер на {{baseUrl}} и тестовые данные (python -m app.seed). Запросы выполняются по порядку (Run collection): созданные объекты передаются дальше через переменные коллекции и удаляются в конце.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8000"
    },
    {
      "key": "suffix",
      "value": ""
    },
    {
      "key": "roomTypeId",
      "value": ""
    },
    {
      "key": "roomId",
      "value": ""
    },
    {
      "key": "userId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Служебные",
      "item": [
        {
          "name": "Проверка API и БД",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/health"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Статус 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"БД доступна\", () => pm.expect(pm.response.json().database).to.eql(\"ok\"));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Категории номеров",
      "item": [
        {
          "name": "Создать категорию",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/room-types",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Тестовая {{suffix}}\",\n  \"capacity\": 2,\n  \"price_per_night\": 2999.99,\n  \"description\": \"Создано из Postman\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set(\"suffix\", Date.now().toString().slice(-6));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Статус 201\", () => pm.response.to.have.status(201));",
                  "const body = pm.response.json();",
                  "pm.test(\"Есть id\", () => pm.expect(body.id).to.be.a(\"number\"));",
                  "pm.test(\"Цена хранится с копейками\", () => pm.expect(body.price_per_night).to.eql(\"2999.99\"));",
                  "pm.collectionVariables.set(\"roomTypeId\", body.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Дубль названия",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/room-types",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Тестовая {{suffix}}\",\n  \"capacity\": 2,\n  \"price_per_night\": 100\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Статус 409\", () => pm.response.to.have.status(409));",
                  "pm.test(\"error_code: CONFLICT\", () => pm.expect(pm.response.json().error_code).to.eql(\"CONFLICT\"));",
                  "pm.test(\"field: name\", () => pm.expect(pm.response.json().field).to.eql(\"name\"));",
                  "pm.test(\"detail: already exists\", () => pm.expect(pm.response.json().detail).to.include(\"already exists\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "Невалидные данные",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/room-types",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"\",\n  \"capacity\": 0,\n  \"price_per_night\": -5\n}",
