{
  "info": {
    "name": "HotelBooking API",
    "description": "CRUD API HotelBooking: категории номеров, номера, пользователи. Пагинация page/per_page с метаданными, сортировка sort_by/sort_order, единый формат ошибок с error_code.\n\nПеред запуском: сервер на {{baseUrl}} и тестовые данные (python -m app.seed). Запросы выполняются по порядку (Run collection): созданные объекты передаются дальше через переменные коллекции и удаляются в конце.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8000"
    },
    {
      "key": "suffix",
      "value": ""
    },
    {
      "key": "roomTypeId",
      "value": ""
    },
    {
      "key": "roomId",
      "value": ""
    },
    {
      "key": "userId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Служебные",
      "item": [
        {
          "name": "Проверка API и БД",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/health"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Статус 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"БД доступна\", () => pm.expect(pm.response.json().database).to.eql(\"ok\"));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Категории номеров",
      "item": [
        {
          "name": "Создать категорию",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/room-types",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Тестовая {{suffix}}\",\n  \"capacity\": 2,\n  \"price_per_night\": 2999.99,\n  \"description\": \"Создано из Postman\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set(\"suffix\", Date.now().toString().slice(-6));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Статус 201\", () => pm.response.to.have.status(201));",
                  "const body = pm.response.json();",
                  "pm.test(\"Есть id\", () => pm.expect(body.id).to.be.a(\"number\"));",
                  "pm.test(\"Цена хранится с копейками\", () => pm.expect(body.price_per_night).to.eql(\"2999.99\"));",
                  "pm.collectionVariables.set(\"roomTypeId\", body.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Дубль названия",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/room-types",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Тестовая {{suffix}}\",\n  \"capacity\": 2,\n  \"price_per_night\": 100\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Статус 409\", () => pm.response.to.have.status(409));",
                  "pm.test(\"error_code: CONFLICT\", () => pm.expect(pm.response.json().error_code).to.eql(\"CONFLICT\"));",
                  "pm.test(\"field: name\", () => pm.expect(pm.response.json().field).to.eql(\"name\"));",
                  "pm.test(\"detail: already exists\", () => pm.expect(pm.response.json().detail).to.include(\"already exists\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "Невалидные данные",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/room-types",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"\",\n  \"capacity\": 0,\n  \"price_per_night\": -5\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Статус 422\", () => pm.response.to.have.status(422));",
                  "pm.test(\"Ошибка валидации в формате FastAPI\", () => pm.expect(pm.response.json().detail).to.be.an(\"array\").that.is.not.empty);",
                  "pm.test(\"Три ошибки: name, capacity, price\", () => pm.expect(pm.response.json().detail).to.have.lengthOf(3));"
                ]
              }
            }
          ]
        },
        {
          "name": "Список с пагинацией",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/room-types?page=1&per_page=5"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Статус 200\", () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test(\"Есть метаданные пагинации\", () => pm.expect(body).to.include.all.keys(\"items\", \"total\", \"page\", \"per_page\", \"total_pages\"));",
                  "pm.test(\"total_pages посчитан верно\", () => pm.expect(body.total_pages).to.eql(Math.ceil(body.total / body.per_page)));",
                  "pm.test(\"Не больше per_page записей\", () => pm.expect(body.items).to.be.an(\"array\").with.length.at.most(5));",
                  "pm.test(\"Первая страница\", () => pm.expect(body.page).to.eql(1));"
                ]
              }
            }
          ]
        },
        {
          "name": "per_page больше 100",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/room-types?per_page=500"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Статус 422\", () => pm.response.to.have.status(422));",
                  "pm.test(\"Ошибка валидации в формате FastAPI\", () => pm.expect(pm.response.json().detail).to.be.an(\"array\").that.is.not.empty);"
                ]
              }
            }
          ]
        },
        {
          "name": "Сортировка по цене по убыванию",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/room-types?sort_by=price_per_night&sort_order=desc&per_page=100"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Статус 200\", () => pm.response.to.have.status(200));",
                  "const prices = pm.response.json().items.map(r => Number(r.price_per_night));",
                  "pm.test(\"Цены идут по убыванию\", () => pm.expect(prices).to.eql([...prices].sort((a, b) => b - a)));"
                ]
              }
            }
          ]
        },
        {
          "name": "Неверное поле сортировки",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/room-types?sort_by=description"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Статус 400\", () => pm.response.to.have.status(400));",
                  "pm.test(\"error_code: VALIDATION_ERROR\", () => pm.expect(pm.response.json().error_code).to.eql(\"VALIDATION_ERROR\"));",
                  "pm.test(\"field: sort_by\", () => pm.expect(pm.response.json().field).to.eql(\"sort_by\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "Категория по id",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/room-types/{{roomTypeId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Статус 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Тот самый id\", () => pm.expect(pm.response.json().id).to.eql(Number(pm.collectionVariables.get(\"roomTypeId\"))));"
                ]
              }
            }
          ]
        },
        {
          "name": "Несуществующая категория",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/room-types/999999"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Статус 404\", () => pm.response.to.have.status(404));",
                  "pm.test(\"error_code: NOT_FOUND\", () => pm.expect(pm.response.json().error_code).to.eql(\"NOT_FOUND\"));",
                  "pm.test(\"detail: not found\", () => pm.expect(pm.response.json().detail).to.include(\"not found\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "PUT: полная замена",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/room-types/{{roomTypeId}}",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Тестовая {{suffix}} PUT\",\n  \"capacity\": 3,\n  \"price_per_night\": 3100\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Статус 200\", () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test(\"Поля заменены\", () => { pm.expect(body.capacity).to.eql(3); pm.expect(body.price_per_night).to.eql(\"3100.00\"); });",
                  "pm.test(\"Неприсланное описание сброшено в null\", () => pm.expect(body.description).to.be.null);"
                ]
              }
            }
          ]
        },
        {
          "name": "PATCH: одно поле",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/room-types/{{roomTypeId}}",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"description\": \"Изменено через PATCH\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Статус 200\", () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test(\"Описание изменено\", () => pm.expect(body.description).to.eql(\"Изменено через PATCH\"));",
                  "pm.test(\"Остальные поля не тронуты\", () => pm.expect(body.capacity).to.eql(3));"
                ]
              }
            }
          ]
        },
        {
          "name": "PATCH: null в обязательное поле",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/room-types/{{roomTypeId}}",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": null\n}",
