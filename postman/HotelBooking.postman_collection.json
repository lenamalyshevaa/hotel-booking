          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Статус 422\", () => pm.response.to.have.status(422));",
                  "pm.test(\"Ошибка валидации в формате FastAPI\", () => pm.expect(pm.response.json().detail).to.be.an(\"array\").that.is.not.empty);"
                ]
              }
            }
          ]
        }
      ]
    },
