# Скопируйте этот файл в .env и при необходимости поправьте значения.
# Файл .env в Git не попадает (см. .gitignore).

# Локальный PostgreSQL (порт 5432)
DATABASE_URL=postgresql+psycopg2://hotel:hotel@localhost:5432/hotel_booking

# PostgreSQL из docker-compose (проброшен на порт 5433, чтобы не мешать локальному)
# DATABASE_URL=postgresql+psycopg2://hotel:hotel@localhost:5433/hotel_booking

# Печатать SQL-запросы ORM в консоль (true в разработке)
SQL_ECHO=false

# Пул соединений
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
